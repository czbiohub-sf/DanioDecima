# Copy this file to daniocell_paths.env and fill in the values.
# Source it before running or submitting any DanioCell script:
#   source daniodecima-main/scripts/daniocell_paths.env
# Submit SLURM jobs from "$DANIOCELL_WORKDIR/experiments" so relative logs/ paths resolve.
# Repository root containing the DanioDecima code.
export DANIODECIMA_REPO=/path/to/daniodecima-repo
# DanioCell scratch directory for processed data and results.
export DANIOCELL_WORKDIR=/path/to/daniocell-workdir
# DanioCell input and pseudobulk data directory.
export DANIOCELL_DATA_DIR=/path/to/daniocell-data
# Annotated DanioCell atlas H5AD file.
export DANIOCELL_ATLAS_H5AD=/path/to/daniocell-atlas.h5ad
# GRCz11 reference directory containing genes/ and fasta/.
export GRCZ11_REF_DIR=/path/to/grcz11-reference
# Zebrahub sequence-to-function data directory.
export ZEBRAHUB_DATA_DIR=/path/to/zebrahub-data
# Zebrahub scratch directory for optional transfer runs 8-11.
export ZEBRAHUB_WORKDIR=/path/to/zebrahub-workdir
# Zebrafish-to-human ortholog CSV file.
export ORTHOLOG_CSV=/path/to/zebrafish-human-orthologs.csv
# Zebrahub multiome ATAC peaks BED file.
export ATAC_PEAKS_BED=/path/to/atac-peaks.bed
